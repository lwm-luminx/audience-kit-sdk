{
  "name": "audience-kit",
  "version": "0.1.0",
  "description": "Node.js and TypeScript client for the AudienceKit API: sign people in, then read an audience's venues, people, locales, events, cover and chat over GraphQL.",
  "license": "SEE LICENSE IN https://github.com/lwm-luminx/audience-kit-sdk/blob/main/LICENSE",
  "author": "Love Wins Media, Inc.",
  "homepage": "https://github.com/lwm-luminx/audience-kit-sdk/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwm-luminx/audience-kit-sdk.git",
    "directory": "node"
  },
  "bugs": "https://github.com/lwm-luminx/audience-kit-sdk/issues",
  "keywords": [
    "audiencekit",
    "graphql",
    "hotmess",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run coverage && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "graphql": "^16.11.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
